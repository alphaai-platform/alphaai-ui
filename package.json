{
  "name": "alphaai",
  "version": "0.0.0",
  "private": true,
  "description": "Alpha AI monorepo — shared design system and product frontends.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build",
    "typecheck": "pnpm -r --filter ./packages/* typecheck",
    "lint": "pnpm -r --filter ./packages/* lint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r --filter ./packages/* build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
