{
  "name": "@alphaai/tailwind-preset",
  "version": "0.1.1",
  "description": "Tailwind v4 preset for AlphaAI products. Single CSS import wires up Tailwind, tw-animate-css, the @theme inline block, and base tokens.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cn.js",
  "module": "./dist/cn.js",
  "types": "./dist/cn.d.ts",
  "files": [
    "dist",
    "theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js"
    },
    "./theme.css": "./theme.css",
    "./cn": {
      "types": "./dist/cn.d.ts",
      "import": "./dist/cn.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint'"
  },
  "dependencies": {
    "@alphaai/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
